{
  "name": "capcut-mcp-server",
  "version": "2.0.0-local",
  "description": "Local-only MCP server for CapCut editing via a loopback VectCutAPI",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/index.js",
    "build:test": "tsc -p tsconfig.test.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "npm run typecheck",
    "test": "npm run build:test && node --test \"dist-test/tests/*.test.js\"",
    "smoke": "node scripts/smoke.mjs",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/index.js"
  },
  "bin": {
    "capcut-mcp-server": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "mcp",
    "capcut",
    "video-editing",
    "vectcutapi"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "20.19.9",
    "typescript": "5.9.3"
  }
}
